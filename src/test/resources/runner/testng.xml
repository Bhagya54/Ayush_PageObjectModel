<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BasicSuite">
	<groups>
		<run>
			<include name="smoke"></include>
			<exclude name="sanity"></exclude>
		</run>
	</groups>


	<test thread-count="5" name="AnnotationTest">
		<classes>
			<class name="testng_testcases.Annotations" />

		</classes>
	</test>
	<test thread-count="5" name="AssertionPriorityTest">
		<classes>
			<class name="testng_testcases.Assertion" />
			<class name="testng_testcases.Priority" />
		</classes>
	</test>



	<!-- BasicTest -->
</suite> <!-- BasicSuite -->
